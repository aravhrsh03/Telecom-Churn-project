# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# --- Database -------------------------------------------------------------
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=proj

# --- FastAPI service key (sent by the frontend as X-API-Key) -------------
API_KEY=qwertyuiop

# --- Claude API (required for Phase 7 + Phase 8 features) ----------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides (see docs/ai1_model_comparison.md for why these were chosen)
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STRONG=claude-sonnet-5
